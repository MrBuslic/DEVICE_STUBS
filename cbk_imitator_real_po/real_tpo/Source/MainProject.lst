0002- /*! \file CmdHandlerUnit.c
0003-  * \author Гапонов Р.В.
0004-  * \date 2014.02.03
0005-  * \version 1.1.0
0006-  * \brief Модуль содержит функции обработки команд КПА, специфичных для комплекта аппаратуры ЕРТИ
0007-  */
0008- 
0009- #include "MainUnit.h"
0010- //================================================================================
0011- 
0012- #ifdef SPO_ERTI
0013- 
0014- /*! \fn void KpaCommand08 (int BaseMkoLine, int BaseMkoChan);
0015-  * \brief Функция обработки команды 0x08: установить заданную конфигурацию 14Р732. Вызывается при обработке прерывания от КПА
0016-  * \param [in] BaseMkoLine - номер линии МКО для обмена с КПА
0017-  * \param [in] BaseMkoChan - номер канала МКО для обмена с КПА
0018-  * \details <b> Формат данных команды: </b><br>
0019-  * слово команды [0] биты [7..0] - код команды (0x08) <br>
0020-  * слово команды [1] биты [1..0] - код конфигурации блока МУ (0 - не менять конфигурацию, 1 - вкл осн канал, 2 - вкл рез канал, 3 - ошибка в команде) <br>
0021-  * слово команды [1] биты [3..2] - код конфигурации блока МВКУ (0 - не менять конфигурацию, 1 - вкл осн канал, 2 - вкл рез канал, 3 - выключить все) <br>
0022-  * слово команды [1] биты [5..4] - код конфигурации блока МПВН (0 - не менять конфигурацию, 1 - вкл осн канал, 2 - вкл рез канал, 3 - выключить все) <br>
0023-  * слово команды [1] биты [9..6] - маска конфигурации блока ВЧМ (если бит маски = 1 - вкл канал, если = 0 - выкл канал) <br>
0024-  * слово команды [2] - если не 0 = время на ожидание готовности блока МУ, мсек (если 0 = время на ожидание готовности = 300 мсек) <br>
0025-  * слово команды [3] - если не 0 = пауза при включении ВЧМ, мсек (если 0 = пауза со значением по умолчанию = 100 мс) <br>
0026-  * <b> Работа команды: </b><br>
0027-  * производится проверка параметров команды на допустимость <br>
0028-  * производится считывание текущей конфигурации 14Р732 <br>
0029-  * производится анализ текущей и запрошенной конфигураций <br>
0030-  * производится переключение конфигураций блоков (блоки ВЧМ всегда выключаются перед установкой конфигурации) <br>
0031-  * производится повторное считывание конфигурации 14Р732 <br>
0032-  * производится проверка соответствия запрошенной и установленной конфигураций <br>
0033-  * производится передача результата выполнения на КПА <br>
0034-  */
0035- 
