0103- */
0104- 
0105- // [номера слов] (option: [номера битов])
0106- 
0107- // данные на подадресе 1 МКПА:
0108- // [0][7..0] - код команды, = 0x65
0109- // [0][15..8] - код операции, = 1..3
0110- 
0111- // код операции = 0x01, тест абонента МКО на запись (тип обмена МКО Ф2)
0112- // [0][7..0] - код команды, = 0x65
0113- // [0][15..8] - код операции, = 1
0114- // [1][0] - линия МКО для операции (0 = 1 линия МКО, 1 = 2 линия МКО)
0115- // [1][1] - канал МКО для операции (0 = основной канал МКО, 1 = резервный канал МКО)
0116- // [2] - команда МКО для операции (16 бит, [Адрес, Направление, Подадрес, Размер данных])
0117- // [3] - число сообщений, которое будет передано абоненту МКО (1..65535)
0118- // [4] - размер пакета МКО, сообщений (1..32, если параметр = 0, число сообщений по умолчанию = 32)
0119- // [5] - интервал "начало сообщения - начало сообщения" в пакете МКО, мксек (0..65535)
0120- // дополнительные данные на подадрсе 2: 
0121- // 1..32 слова для передачи абоненту в сообщении
0122- // возврат, результат: OK/Error
0123- // возврат, данные: 8 слов со статистикой обмена
0124- // [0] = общее число переданных сообщений
0125- // [1] = общее число возникших ошибок
0126- // [2] = общее число ошибок на линии
0127- // [3] = общее число ошибок "нет ОС"
0128- // [4] = общее число ошибок "неисправность абонента"
0129- // [5] = общее число ошибок "неисправность ОУ"
0130- // [6] = общее число ошибок "абонент занят"
0131- // [7] = общее число ошибок "сбой в сообщении"
0132- // пример: 
0133- // ВЫДАТЬ_ДИР([0x0165, xxxx, xxxx, xxxx, 0], [1,2,3,4,5,6,7,8,...]);
0134- 
0135- // код операции = 0x02, тест абонента МКО на чтение (тип обмена МКО Ф2)
0136- // [0][7..0] - код команды, = 0x65
0137- // [0][15..8] - код операции, = 2
0138- // [1][0] - линия МКО для операции (0 = 1 линия МКО, 1 = 2 линия МКО)
0139- // [1][1] - канал МКО для операции (0 = основной канал МКО, 1 = резервный канал МКО)
0140- // [2] - команда МКО для операции (16 бит, [Адрес, Направление, Подадрес, Размер данных])
0141- // [3] - число сообщений, которое будет считано от абонента МКО (1..65535)
0142- // [4] - размер пакета МКО, сообщений (1..32, если параметр = 0, число сообщений по умолчанию = 32)
0143- // [5] - интервал "начало сообщения - начало сообщения" в пакете МКО, мксек (0..65535)
0144- // дополнительные данные на подадрсе 2: 
0145- // 1..32 слова для контроля принятых данных от абонента
0146- // возврат, результат: OK/Error
0147- // возврат, данные: 9 слов со статистикой обмена
0148- // [0] = общее число переданных сообщений
0149- // [1] = общее число возникших ошибок
0150- // [2] = общее число ошибок на линии
0151- // [3] = общее число ошибок "нет ОС"
0152- // [4] = общее число ошибок "неисправность абонента"
0153- // [5] = общее число ошибок "неисправность ОУ"
0154- // [6] = общее число ошибок "абонент занят"
0155- // [7] = общее число ошибок "сбой в сообщении"
0156- // [8] = общее число ошибок "принятые данные несовпадают с ожидаемыми"
0157- // пример: 
0158- // ВЫДАТЬ_ДИР([0x0265, xxxx, xxxx, xxxx, 0], [1,2,3,4,5,6,7,8,...]);
0159- 
0160- // код операции = 0x03, передача обоненту МКО команды (тип обмена МКО Ф4)
0161- // [0][7..0] - код команды, = 0x65
0162- // [0][15..8] - код операции, = 3
0163- // [1][0] - линия МКО для операции (0 = 1 линия МКО, 1 = 2 линия МКО)
0164- // [1][1] - канал МКО для операции (0 = основной канал МКО, 1 = резервный канал МКО)
0165- // [2] - команда МКО для операции (16 бит, [Адрес, Направление, Подадрес, Размер данных])
0166- // возврат, результат: OK/Error
0167- // возврат, данные: 1 слово
0168- // [0] = принятое ОС от абонента (или 0xFFFF если была ошибка до обмена)
0169- // пример: 
0170- // ВЫДАТЬ_ДИР([0x0365, xxxx, xxxx], []);
0171- 
0172- // код операции = 0x04, управление передачей статистики обменов МКО (если вкл - после обработки команд 1..3 выдает полный результат обмена по последнему пакету МКО)
0173- // [0][7..0] - код команды, = 0x65
0174- // [0][15..8] - код операции, = 4
0175- // [1] - флаг управления (0 = откл выдачу статистики, не 0 = вкл выдачу статистики)
0176- // возврат, результат: OK
0177- // возврат, данные: нет
0178- // пример: 
0179- // ВЫДАТЬ_ДИР([0x0465, 1], []);
0180- 
