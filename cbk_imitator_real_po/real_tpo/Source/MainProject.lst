3475- 
3476- // код операции = 0x1D, настройка данных пакетной передачи
3477- // [1][15..0] = код операции
3478- //   0x0000 = добавить сообщение в пакет
3479- //     если пакет запущен = ошибка
3480- //   0x0001 = добавить начальную паузу для пакета
3481- //     если пакет запущен = ошибка
3482- //   0x0002 = добавить интервал для пакета
3483- //     если пакет запущен = ошибка
3484- //   0x0003 = добавить линию/канал МКО для пакета
3485- //     если пакет запущен = ошибка
3486- // если добавляется сообщение в пакет (код опер. 0x0000):
3487- //   [2][7..0]  = номер пакета, 0..31
3488- //   [2][15..8] = флаг режима (0 – запись, 1 – чтение)
3489- //   [3][7..0]  = адрес, от 0 до 30
3490- //   [3][15..8] = подадрес, от 1 до 30
3491- //   [4][7..0]  = число слов данных, 1..32
3492- //   если режим сообщения = передача, считываются данные с п/а 2 для передачи
3493- // если добавляется начальная пауза для пакета (код опер. 0x0001):
3494- //   [2][7..0]  = номер пакета, 0..31
3495- //   [3][15..0] = начальная однократная пауза для пакета, мсек, 10..65535
3496- // если добавляется интервал для пакета (код опер. 0x0002):
3497- //   [2][7..0]  = номер пакета, 0..31
3498- //   [3][15..0] = интервал для пакета, мсек, 500..60000
3499- // если добавляется линия/канал МКО для пакета (код опер. 0x0003):
3500- //   [2][7..0]  = номер пакета, 0..31
