0033- #define BIGBLOCKSIZE    (sizeof (long) << 2)
0034- /* How many bytes are copied each iteration of the word copy loop.  */
0035- #define LITTLEBLOCKSIZE (sizeof (long))
0036- /* Threshhold for punting to the byte copier.  */
0037- #define TOO_SMALL(LEN)  ((LEN) < BIGBLOCKSIZE)
