1427- /*
1428- адрес 7/1, чтение конфигурации, 2 слова
1429- CD0 бит 8  - включен 1-й канал ФСМУ
1430- CD0 бит 9  - включен 2-й канал ФСМУ
1431- CD0 бит 10 - включен 3-й канал ФСМУ
1432- CD0 бит 11 - включен 1-й канал ФСВУ
1433- CD0 бит 12 - включен 2-й канал ФСВУ
1434- CD0 бит 13 - включен 3-й канал ФСВУ
1435- 
1436- CD1 бит 2 - подключена МНА-У
1437- CD1 бит 3 - подключена МНА+У
1438- CD1 бит 4 - подключена ОНА
1439- CD1 бит 5 - включен кварцевый генератор 2
1440- CD1 бит 6 - включен кварцевый генератор 1
1441- CD1 бит 7 - включен режим высокой стабильности
1442- 
1443- адрес 4/28, установка конфигурации МБК07
1444- 0x8001 = Включить 1-й канал ФСМУ, отключить 2-й и 3-й каналы
1445- 0x9001 = Включить 2-й канал ФСМУ, отключить 1-й и 3-й каналы
1446- 0xA001 = Включить 3-й канал ФСМУ, отключить 1-й и 2-й каналы
1447- 0xB001 = Отключить ФСМУ
1448- 
1449- 0x8004 = Включить 1-й канал ФСВУ, отключить 2-й и 3-й каналы
1450- 0x9004 = Включить 2-й канал ФСВУ, отключить 1-й и 3-й каналы
1451- 0xA004 = Включить 3-й канал ФСВУ, отключить 1-й и 2-й каналы
1452- 0xB004 = Выключить ФСВУ
1453- 
1454- 0xA002 = Включить КГ1, отключить КГ2
1455- 0xB002 = Включить КГ2, отключить КГ1
1456- 
1457- 0x8008 = Переключить МБК07 на ОНА
1458- 0x9008 = Переключить МБК07 на МНА+У
1459- 0xA008 = Переключить МБК07 на МНА-У
1460- 
1461- 0x9002 = Включить режим ВС, отключить НС, КГ1 и КГ2
1462- */
