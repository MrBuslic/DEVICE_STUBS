0020- // [0][15..8] - код операции, = 1..7
0021- 
0022- // код операции = 1, чтение состояния блокировки периодических сообщений МКО
0023- // возврат, результат: OK
0024- // возврат, данные: 1 слово, = 0 - нет блокировки, = 1 - есть блокировка
0025- 
0026- // код операции = 2, изменить состояние блокировки периодических сообщений МКО
0027- // [1] - 1 = установить, 0 = снять
0028- // возврат, результат: OK
0029- // возврат, данные: нет
0030- 
0031- // код операции = 3, добавление сообщения в список периодических сообщений МКО
0032- // [1][15..0] - команда абоненту МКО
0033- // [2][0] - линия МКО для обмена, 0/1
0034- // [2][1] - канал МКО для обмена, 0/1
0035- // [2][2] - 0 = обычный обмен, 1 = команда в формате Ф4, 
0036- // [3][15..0] - интервал передачи сообщения, сек
0037- // [4][15..0] - сколько раз передать сообщение (0xFFFF = непрерывно)
0038- // если добавляется сообщение на запись абонента:
0039- // данные на подадресе 2:
0040- // [n..0] - данные для записи в абонент
0041- // возврат, результат: OK/ошибка
0042- // возврат, данные: нет
0043- // инфо: требует блокировку списка
0044- 
0045- // код операции = 4, удаление сообщения из списка периодических сообщений МКО
0046- // [1][15..0] - команда абоненту МКО, удаляемая из списка
