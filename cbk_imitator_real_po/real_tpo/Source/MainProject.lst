0001- /*
0002- FUNCTION
0003- 	<<memcmp>>---compare two memory areas
0004- INDEX
0005- 	memcmp
0006- ANSI_SYNOPSIS
0007- 	#include <string.h>
0008- 	int memcmp(const void *<[s1]>, const void *<[s2]>, size_t <[n]>);
0009- TRAD_SYNOPSIS
0010- 	#include <string.h>
0011- 	int memcmp(<[s1]>, <[s2]>, <[n]>)
0012- 	void *<[s1]>;
0013- 	void *<[s2]>;
0014- 	size_t <[n]>;
0015- DESCRIPTION
0016- 	This function compares not more than <[n]> characters of the
0017- 	object pointed to by <[s1]> with the object pointed to by <[s2]>.
0018- RETURNS
0019- 	The function returns an integer greater than, equal to or
0020- 	less than zero 	according to whether the object pointed to by
0021- 	<[s1]> is greater than, equal to or less than the object
0022- 	pointed to by <[s2]>.
0023- PORTABILITY
0024- <<memcmp>> is ANSI C.
0025- <<memcmp>> requires no supporting OS subroutines.
0026- QUICKREF
0027- 	memcmp ansi pure
0028- */
0029- #include <string.h>
0030- /* Nonzero if either X or Y is not aligned on a "long" boundary.  */
0031- #define UNALIGNED(X, Y) \
0032-   (((long)X & (sizeof (long) - 1)) | ((long)Y & (sizeof (long) - 1)))
0033- /* How many bytes are copied each iteration of the word copy loop.  */
0034- #define LBLOCKSIZE (sizeof (long))
0035- /* Threshhold for punting to the byte copier.  */
0036- #define TOO_SMALL(LEN)  ((LEN) < LBLOCKSIZE)
0037- int
0038- _DEFUN (memcmp, (m1, m2, n),
0039- 	_CONST _PTR m1 _AND
0040- 	_CONST _PTR m2 _AND
0041- 	size_t n)
0042- {
0043- #ifdef PREFER_SIZE_OVER_SPEED
0044-   unsigned char *s1 = (unsigned char *) m1;
0045-   unsigned char *s2 = (unsigned char *) m2;
0046-   while (n--)
0047-     {
0048-       if (*s1 != *s2)
0049- 	{
0050- 	  return *s1 - *s2;
0051- 	}
0052-       s1++;
0053-       s2++;
0054-     }
0055-   return 0;
0056- #else
0057-   unsigned char *s1 = (unsigned char *) m1;
0058-   unsigned char *s2 = (unsigned char *) m2;
0059-   unsigned long *a1;
0060-   unsigned long *a2;
0061-   /* If the size is too small, or either pointer is unaligned,
0062-      then we punt to the byte compare loop.  Hopefully this will
0063-      not turn up in inner loops.  */
