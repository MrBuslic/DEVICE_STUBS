0015- 
0016- // формирование командного слова МКО
0017- function MKO_CMD (Addr, SubAddr, Dir, Size)
0018- {
0019- var Cmd = 0;
0020- Cmd |= (Addr & 0x1F) << 11;
0021- Cmd |= (Dir & 0x01) << 10;
0022- Cmd |= (SubAddr & 0x1F) << 5;
0023- Cmd |= (Size & 0x1F) << 0;
0024- return Cmd;
0025- }
0026- //================================================================================
0027- 
0028- // вызов функции СПО для тестирования МКО
0029- function МКО_НАГРУЗОЧНЫЙ_ТЕСТ (Mode, MkoLine, MkoChan, MkoAddr, MkoSubAddr, MkoCmdSize, MkoData, MsgCount, PackSize, Interval)
0030- {
0031- var Result;
0032- var Link = ((MkoLine) ? (1) : (0)) | ((MkoChan) ? (2) : (0));
0033- Mode = Mode.toLowerCase();
0034- 
0035- if (Mode == "запись")
0036-   {
0037-   if (MkoData.length != MkoCmdSize) return -1;
0038-   var MkoCmd = MKO_CMD(MkoAddr, MkoSubAddr, 0, MkoCmdSize);
0039-   Result = ВЫДАТЬ_ДИР([0x0165, Link, MkoCmd, MsgCount, PackSize, Interval], MkoData, 240000);
0040-   if (Result) Result = 1;
0041-   }
0042- else if (Mode == "чтение")
0043-   {
0044-   if (MkoData.length != MkoCmdSize) return -1;
0045-   var MkoCmd = MKO_CMD(MkoAddr, MkoSubAddr, 1, MkoCmdSize);
0046-   Result = ВЫДАТЬ_ДИР([0x0265, Link, MkoCmd, MsgCount, PackSize, Interval], MkoData, 240000);
0047-   if (Result) Result = 1;
0048-   }
0049- else if (Mode == "команда")
0050-   {
0051-   // выбираем направление команды F4 для указанного кода операции
0052-   var CmdDir = (0x000DFFFF & (1 << (MkoCmdSize & 0x1F))) ? (1) : (0);
0053-   var MkoCmd = MKO_CMD(MkoAddr, MkoSubAddr, CmdDir, MkoCmdSize);
0054-   Result = ВЫДАТЬ_ДИР([0x0365, Link, MkoCmd], [], 5000);
0055-   if (Result) Result = 1;
0056-   }
0057- else
0058-   {
0059-   Result = -1;
0060-   }
0061- 
0062- return Result;
0063- }
0064- //================================================================================
0065- 
0066- // примеры
0067- var Result = МКО_НАГРУЗОЧНЫЙ_ТЕСТ("запись", 1,1, 5,5,5, [1,2,3,4,5], 10000,32,0);
0068- if (Result == 0)
0069-   {
0070-   if (МКО_БУФЕР[0]) ...
0071-   if (МКО_БУФЕР[1]) ...
0072-   if (МКО_БУФЕР[2]) ...
0073-   if (МКО_БУФЕР[3]) ...
0074-   }
0075- else
0076-   {
0077-   ВЫВЕСТИ("Ошибка теста МКО (запись)");
0078-   }
0079- 
0080- var Result = МКО_НАГРУЗОЧНЫЙ_ТЕСТ("чтение", 1,1, 5,5,5, [1,2,3,4,5], 10000,32,0);
0081- if (Result == 0)
0082-   {
0083-   if (МКО_БУФЕР[0]) ...
0084-   if (МКО_БУФЕР[1]) ...
0085-   if (МКО_БУФЕР[2]) ...
0086-   if (МКО_БУФЕР[3]) ...
0087-   }
0088- else
0089-   {
0090-   ВЫВЕСТИ("Ошибка теста МКО (чтение)");
0091-   }
0092- 
