0128- /*! \fn int MkoXchgBn (int MkoLine, int MkoChan, WORD MkoCmd, int F4Mode);
0129-  * \brief Функция передает одно сообщение по МКО, используется пакет B. Используется в функциях, вызываемых из прерываний СПО
0130-  * \param [in] MkoLine - номер линии МКО для обмена (0 = 1 линия, 1 = 2 линия)
0131-  * \param [in] MkoChan - номер канала МКО для обмена (0 = основной канал, 1 = резервный канал)
