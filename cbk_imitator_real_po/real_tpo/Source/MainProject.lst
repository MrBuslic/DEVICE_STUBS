0247- // код операции = 0x1C, сброс пакетной передачи
0248- // [1][15..0] = код операции
0249- //   0x0000 = очистить все пакеты
0250- //     если пакеты запущены, они останавливаются
0251- //     удаляются все сообщения
0252- //     удаляется вся статистика
0253- //   0x0001 = очистить указанный пакет
0254- //     если пакет запущен, он останавливается
0255- //     удаляются все сообщения из пакета
0256- //     удаляется вся статистика по пакету
0257- //   0x0002 = только сброс статистики пакета
0258- //     состояние пакета при сбросе не важно
0259- // [2][7..0] = номер пакета, 0..31 (если требуется)
0260- 
0261- // код операции = 0x1D, настройка данных пакетной передачи
0262- // [1][15..0] = код операции
0263- //   0x0000 = добавить сообщение в пакет
0264- //     если пакет запущен = ошибка
0265- //   0x0001 = добавить начальную паузу для пакета
0266- //     если пакет запущен = ошибка
0267- //   0x0002 = добавить интервал для пакета
0268- //     если пакет запущен = ошибка
0269- //   0x0003 = добавить линию/канал МКО для пакета
0270- //     если пакет запущен = ошибка
0271- // если добавляется сообщение в пакет (код опер. 0x0000):
0272- //   [2][7..0]  = номер пакета, 0..31
0273- //   [2][15..8] = флаг режима (0 – запись, 1 – чтение)
0274- //   [3][7..0]  = адрес, от 0 до 30
0275- //   [3][15..8] = подадрес, от 1 до 30
0276- //   [4][7..0]  = число слов данных, 1..32
0277- //   если режим сообщения = передача, считываются данные с п/а 2 для передачи
0278- // если добавляется начальная пауза для пакета (код опер. 0x0001):
0279- //   [2][7..0]  = номер пакета, 0..31
0280- //   [3][15..0] = начальная однократная пауза для пакета, мсек, 10..65535
0281- // если добавляется интервал для пакета (код опер. 0x0002):
0282- //   [2][7..0]  = номер пакета, 0..31
0283- //   [3][15..0] = интервал для пакета, мсек, 500..60000
0284- // если добавляется линия/канал МКО для пакета (код опер. 0x0003):
0285- //   [2][7..0]  = номер пакета, 0..31
0286- //   [3][7..0]  = линия МКО для пакета, 0..1
0287- //   [3][15..8] = канал МКО для пакета, 0..1
0288- 
0289- // код операции = 0x1E, запуск/останов пакетной передачи
0290- // [1][15..0] = код операции
0291- //   0x0000 = запуск всех непустых пакетов
0292- //     если пакет уже запущен, ничего не делается
0293- //     если нет пакетов для запуска, ничего не делается
0294- //   0x0001 = запуск указанного пакета
0295- //     если пакет пуст = ошибка
0296- //     если пакет уже запущен, ничего не делается
0297- //   0x0002 = стоп всех пакетов
0298- //     если нет запущеных пакетов, ничего не делается
0299- //   0x0003 = стоп указанного пакета
0300- //     если пакет не запущен, ничего не делается
0301- // [2][7..0] = номер пакета, 0..31 (если требуется)
0302- 
0303- // код операции = 0x1F, чтение данных пакетной передачи
0304- // [1][15..0] = код операции
0305- //   0x0000 = чтение статистики для пакета
0306- // [2][7..0] = номер пакета, 0..31 (если требуется)
