0001- 
0002- /*! \file BaloiUnit.c
0003-  * \author Гапонов Р.В.
0004-  * \date 2018.12.21
0005-  * \version 11.5.0
0006-  * \brief Модуль содержит функции обработки прерывания 13 от Балои
0007-  * Алгоритм работы с БАЛОИ версии 11.5
0008-  */
0009- 
0010- #include "BaloiUnit_v11.h"
0011- //================================================================================
0012- 
0013- #ifdef BALOI_V11
0014- //================================================================================
0015- 
0016- // [номера слов] (option: [номера битов])
0017- 
0018- // данные на подадресе 1:
0019- // [0][7..0] - код команды, = 0x62
0020- // [0][15..8] - код операции, = 1..N
0021- 
0022- // код операции = 0x01, отключение обработки прерывания 13
0023- // возврат, результат: OK
0024- // возврат, данные: нет
0025- // пример:
0026- // ВЫДАТЬ_ДИР([0x0162], []);
0027- 
0028- // код операции = 0x02, включение обработки прерывания 13
0029- // возврат, результат: OK
0030- // возврат, данные: нет
0031- // пример:
0032- // ВЫДАТЬ_ДИР([0x0262], []);
0033- 
0034- // код операции = 0x03, установка кода СЕВ
0035- // [1][15..0] - 1 слово кода СЕВ
0036- // [2][15..0] - 2 слово кода СЕВ
0037- // [3][15..0] - 3 слово кода СЕВ
0038- // возврат, результат: OK
0039- // возврат, данные: нет
0040- // пример:
0041- // ВЫДАТЬ_ДИР([0x0362, 0x1234, 0x1234, 0x1234], []);
0042- 
0043- // код операции = 0x04, чтение кода последнего сообщения
0044- // возврат, результат: OK
0045- // возврат, данные: 1 слово = код последнего сообщения от БАЛОИ
0046- // пример:
0047- // ВЫДАТЬ_ДИР([0x0462], []);
0048- // if (БУФЕР_МКО[0] == 0x1234) ...
0049- 
0050- // код операции = 0x05, передача сообщения в БАЛОИ со словами данных
0051- // [1][15..0] - код сообщения
0052- // [2][15..0] - число слов данных для передачи (от 0 до 32 слов)
