0320- /*! \fn int MkoXchgBnStd (int MkoLine, int MkoChan, WORD MkoCmd, int F4Mode);
0321-  * \brief Служебная функция, производит обмен с устройствами на МКО в обычном режиме, для обмена используется пакет B.
0322-  * \param [in] MkoLine - номер линии МКО для обмена (0 = 1 линия, 1 = 2 линия)
0323-  * \param [in] MkoChan - номер канала МКО для обмена (0 = основной канал, 1 = резервный канал)
0324-  * \param [in] MkoCmd - командное слово МКО для обмена
0325-  * \param [in] F4Mode - признак передачи команды в режиме Ф4 (0 = нет, 1 = да)
0326-  * \return Функция возвращает результат обмена: <br>
0327-  * 0 = успешно <br>
0328-  * >0 = ошибка в функциях обмена (для детальной информации см. таблицы констант) <br>
0329-  * <0 = нет связи/сбой передачи (для детальной информации см. таблицы констант) <br>
0330-  * \details Возможна передача расширенных данных об ошибках обмена (если разрешено в конфигурации СПО).
0331-  */
