0002- /*! \file MkoMirrorUnit.c
0003-  * \author Гапонов Р.В.
0004-  * \date 2013.10.30
0005-  * \version 1.0.0
0006-  * \brief Модуль содержит функции работы с подадресом 30 (зеркало) абонентов МКО
0007-  */
0008- 
0009- #include "MkoMirrorUnit.h"
0010- #include "StdLib.h"
0011- //================================================================================
0012- 
0013- // [номера слов] (option: [номера битов])
0014- 
0015- // данные на подадресе 1:
0016- // [0][7..0] - код команды, = 0x64
0017- // [0][15..8] - код операции, = 1..4
0018- 
0019- // код операции = 1, сброс состояния (в неинициализированное)
0020- // возврат, результат: OK
0021- // возврат, данные: нет
0022- // пример: ВЫДАТЬ_ДИР([0x0164], []);
0023- 
0024- // код операции = 2, установка параметров связи с абонентом
0025- // возврат, результат: OK/Error
0026- // возврат, данные: нет
0027- // пример: ВЫДАТЬ_ДИР([0x0264, Адрес_Абонента, Линия_МКО, Канал_Записи_МКО, Канал_Чтения_МКО], []);
0028- 
0029- // код операции = 3, установка параметров обмена
0030- // возврат, результат: OK/Error
0031- // возврат, данные: нет
0032- // пример: ВЫДАТЬ_ДИР([0x0364, Число_Циклов, Слов_Для_Записи, Слов_Для_Чтения, Интервал_в_мкСек], []);
0033- 
0034- // код операции = 4, запуск обмена с абонентом
0035- // возврат, результат: OK/Error
0036- // возврат, данные: код завершения и 6 слов данных:
0037- // [0] - общее число обменов
0038- // [1] - число ошибок записи абонента 
0039- // [2] - число ошибок чтения абонента
0040- // [3] - число обменов с ошибками
0041- // [4] - число сбойных слов в сообщениях
0042- // [5] - число сбойных бит в сообщениях
0043- // пример: ВЫДАТЬ_ДИР([0x0464], []);
0044- 
0045- #if (0)
0046- // код операции = 5, установка маски режимов обмена
0047- // возврат, результат: OK
0048- // возврат, данные: нет
0049- // пример: ВЫДАТЬ_ДИР([0x0564, Маска], []);
0050- 
0051- // код операции = 6, вкл/откл режима отладки
0052- // возврат, результат: OK
0053- // возврат, данные: нет
0054- // пример: ВЫДАТЬ_ДИР([0x0664, Режим], []);
0055- #endif
0056- 
