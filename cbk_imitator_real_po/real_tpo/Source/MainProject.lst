0001- /*
0002- FUNCTION
0003-         <<memcpy>>---copy memory regions
0004- ANSI_SYNOPSIS
0005-         #include <string.h>
0006-         void* memcpy(void *<[out]>, const void *<[in]>, size_t <[n]>);
0007- TRAD_SYNOPSIS
0008-         void *memcpy(<[out]>, <[in]>, <[n]>
0009-         void *<[out]>;
0010-         void *<[in]>;
0011-         size_t <[n]>;
0012- DESCRIPTION
0013-         This function copies <[n]> bytes from the memory region
0014-         pointed to by <[in]> to the memory region pointed to by
0015-         <[out]>.
0016-         If the regions overlap, the behavior is undefined.
0017- RETURNS
0018-         <<memcpy>> returns a pointer to the first byte of the <[out]>
0019-         region.
0020- PORTABILITY
0021- <<memcpy>> is ANSI C.
0022- <<memcpy>> requires no supporting OS subroutines.
0023- QUICKREF
0024-         memcpy ansi pure
0025- 	*/
0026- #include <_ansi.h>
