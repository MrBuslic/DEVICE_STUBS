0002- /*! \file PacketMkoMsgUnit.c
0003-  * \author Гапонов Р.В.
0004-  * \date 2014.05.13
0005-  * \version 1.0.0
0006-  * \brief Модуль содержит функции выдачи пакетов разных сообщений по МКО
0007-  */
0008- 
0009- #include "MainUnit.h"
0010- //================================================================================
0011- 
0012- int PacketMkoMsgCount;                                                          // число сообщений в списке
0013- TPacketMkoMsg PacketMkoMsgList[PACKET_MKO_MSG_COUNT];                           // список описателей сообщений МКО
0014- 
0015- int PacketMkoIntCount;							        // число интервалов в списке (интервал - секунды, режим обмена - пинг-понг)
0016- TPacketMkoInt PacketMkoIntList[PACKET_MKO_INT_COUNT];                           // список описателей интервалов 
0017- 
0018- int PacketMkoIntCntCount;				        	        // число интервалов в списке (интервал - единицы пакетов, режим обмена - пинг-понг)
0019- TPacketMkoIntCnt PacketMkoIntCntList[PACKET_MKO_INT_COUNT];                     // список описателей интервалов 
0020- 
0021- int PacketMkoIntQueueCount;	                          	                // число интервалов в списке (интервал - секунды, режим обмена - очередь) 
0022- TPacketMkoInt PacketMkoIntQueue0List[PACKET_MKO_INT_COUNT];                     // список описателей интервалов 
0023- TPacketMkoInt PacketMkoIntQueue1List[PACKET_MKO_INT_COUNT];                     // список описателей интервалов 
0024- 
0025- TPacketMkoMsgResult PacketMkoMsgResultList[PACKET_MKO_MSG_COUNT];               // результат обмена для сообщений МКО, если MsgNum = 0xFFFF - обмен не проводился
0026- TPacketMkoMsgResult PacketMkoMsgResultBuf[PACKET_MKO_MSG_COUNT + 2];            // буфер для передачи результата
0027- int LastResult;                                                                 // результат последнего обмена
0028- 
0029- sysTime_t RunPacketBeginTime, RunPacketCurrTime;                         	// время начала прогона/текущее время
0030- //================================================================================
0031- 
0032- int GRES_DBG;
0033- UINT TrackPack, TrackPackCount;
0034- UINT PacketRdDataInfo[2];
0035- //================================================================================
0036- 
0037- // [номера слов] (option: [номера битов])
0038- 
0039- // данные на подадресе 1:
0040- // [0][7..0] - код команды, = 0x63
0041- // [0][15..8] - код операции, = 1..N
0042- 
0043- // код операции = 0x01, добавление сообщения в пакет сообщений МКО
0044- // [1][15..0] - команда абоненту МКО
0045- // [2][0] - линия МКО для обмена, 0/1
0046- // [2][1] - канал МКО для обмена, 0/1
0047- // [2][2] - 0 = обычный обмен, 1 = команда в формате Ф4, 
0048- // [3] - задержка до следующего сообщения в пакете, мксек (мл слово) (0..200000)
0049- // [4] - задержка до следующего сообщения в пакете, мксек (ст слово) (0..200000)
0050- // если добавляется сообщение на запись абонента:
0051- // данные на подадресе 2:
0052- // [n..0] - данные для записи в абонент
0053- // возврат, результат: OK/ошибка
0054- // возврат, данные: нет
0055- 
0056- // код операции = 0x02, удаление сообщения из пакета сообщений МКО (параметр = сообщение) 
0057- // [1][15..0] - команда абоненту МКО, удаляемая из списка
0058- // [2][0] - линия МКО для обмена, 0/1
0059- // [2][1] - канал МКО для обмена, 0/1
0060- // [2][2] - 0 = обычный обмен, 1 = команда в формате Ф4, 
0061- // [3] - задержка до следующего сообщения в пакете, мксек (мл слово) (0..200000)
0062- // [4] - задержка до следующего сообщения в пакете, мксек (ст слово) (0..200000)
0063- // если удаляется сообщение на запись абонента:
0064- // данные на подадресе 2:
0065- // [n..0] - данные для записи в абонент
0066- // возврат, результат: OK/ошибка
0067- // возврат, данные: нет
0068- 
0069- // код операции = 0x03, удаление сообщения из пакета сообщений МКО (параметр = индекс сообщения) 
0070- // [1][15..0] - индекс сообщения, удаляемого из списка (0..n)
0071- // возврат, результат: OK/ошибка
0072- // возврат, данные: нет
0073- 
0074- // код операции = 0x04, получить количество сообщений в пакете сообщений МКО
0075- // возврат, результат: OK
0076- // возврат, данные: 1 слово, = число сообщений в списке
0077- 
0078- // код операции = 0x05, очистить список пакета сообщений МКО
0079- // возврат, результат: OK/ошибка
0080- 
0081- // код операции = 0x06, выполнить обмен для пакета сообщений МКО
0082- // возврат, результат: OK/ошибка
0083- // возврат, данные: при ошибках выдает набор записей TPacketMkoMsgResult по числу сбойных обменов
0084- 
0085- // код операции = 0x07, заменить адреса МКО для сообщений из списка
0086- // возврат, результат: OK/ошибка
0087- 
0088- // код операции = 0x08, заменить подадреса МКО для сообщений из списка
0089- // возврат, результат: OK/ошибка
0090- 
0091- // код операции = 0x09, сброс буфера накопленных данных при чтении
0092- // возврат, результат: OK
0093- 
0094- // код операции = 0x0A, проверка буфера на синхронность в прочими ВМ
0095- // возврат, результат: OK/Ошибка+Код сбойных ВМ
0096- 
0097- // код операции = 0x10, добавление нескольких сообщений в пакет сообщений МКО
0098- 
0099- // код операции = 0x16, выполнить обмен для пакета сообщений МКО (multi msg packet)
0100- 
0101- // код операции = 0x17, передать результат последнего обмена
0102-                        
0103- // код операции = 0x20, добавление интервала в список интервалов (секунды, пинг-понг)
0104- // возврат, результат: OK/ошибка
0105- // код операции = 0x21, добавление указанного сообщения к указанному интервалу
0106- // возврат, результат: OK/ошибка
0107- // код операции = 0x22, запуск прогона сообщений по интервалам
0108- // возврат, результат: OK/ошибка
0109- 
0110- // код операции = 0x28, добавление интервала в список интервалов (пакеты, пинг-понг)
0111- // возврат, результат: OK/ошибка
0112- // код операции = 0x29, добавление указанного сообщения к указанному интервалу
0113- // возврат, результат: OK/ошибка
0114- // код операции = 0x2A, запуск прогона сообщений по интервалам
0115- // возврат, результат: OK/ошибка
0116- 
0117- // код операции = 0x30, добавление интервала в список интервалов (секунды, очередь)
0118- // возврат, результат: OK/ошибка
0119- // код операции = 0x31, добавление указанного сообщения к указанному интервалу
0120- // возврат, результат: OK/ошибка
0121- // код операции = 0x32, запуск прогона сообщений по интервалам
0122- // возврат, результат: OK/ошибка
0123- 
0124- // код операции = 0x38, добавление интервала в список интервалов (пакеты, очередь)
