0002- /*! \file ControlUnit.c
0003-  * \author Гапонов Р.В.
0004-  * \date 2012.10.28
0005-  * \version 1.0.0
0006-  * \brief Модуль содержит функции для поддержки непрерывного контроля устройств БА
0007-  */
0008- 
0009- #include "MainUnit.h"
0010- //================================================================================
0011- 
0012- /*
0013- 
0014- [таблицы данных для контроля OK]
0015- таблица расположения OK: содержит расположение и размеры битовых полей OK
0016- задается до компиляции, неизменяема
0017- 
0018- таблица номеров OK: содержит номера битовых полей OK
0019- каждая запись в таблице относится к записи в таблице распроложения с тем же индексом.
0020- задается до компиляции, неизменяема
0021- 
0022- таблица 1: список устройств, поставленных на контроль
0023- содержимое: 0/1 - признак установки устройств на контроль
0024- контроль: содержимое меняется по запросу КПА
0025- char Control_DeviceList[32];
0026- 
0027- таблица 2: список указателей на параметры контроля
0028- содержимое: указатель на список, содержащий данные по расположению битов OK для конкретного устройства
0029- контроль: содержимое заполняется при инициализации
0030- unsigned *Control_AddrList[32];
0031- 
0032- таблица 3: список указателей на номера OK
0033- содержимое: указатель на список, содержащий номера OK
0034- контроль: содержимое заполняется при инициализации
0035- unsigned *Control_NumList[32];
0036- 
0037- таблица 4: список состояния OK
0038- содержимое: текущее состояние контролируемых OK
0039- контроль: содержимое меняется СПО при контроле ОК от устройств
0040- char Control_StateList[1024];
0041- 
0042- таблица 5: список наличия данных в буфере OK
0043- содержимое: 0 = данных в буфере нет, считывание еще не было произведено, 1 - данные по состоянию OK находятся в буфере
0044- контроль: содержимое меняется СПО при установке устройств на контроль и считывании ОК от устройств
0045- char Control_DataAvail[1024];
0046- 
0047- список, на который указывают элементы таблицы 2:
0048- список unsigned, описывающий положение OK. если поля "адрес/подадрес/размер данных" не пусты (<>0), то требуется провести обмен с устройством.
0049- если поля пусты, использовать данные, полученные в предыдущем обмене. если элемент ==0, список завершен.
0050- 
0051- списки требуют инициализации до начала работы:
0052- таблица 1 - обнулить
0053- таблица 2 - присвоить адреса списков положения OK
0054- таблица 3 - присвоить адреса списков номеров OK
0055- таблица 4 - обнулить
0056- таблица 5 - неважно (сбрасывается при установке устройств на контроль)
0057- 
0058- адрес       5 (<< 0)  0..31
0059- подадрес    5 (<< 5)  0..31
0060- число слов  6 (<< 10) 1..32
0061- номер слова 5 (<< 16) 0..31
0062- номер бита  4 (<< 21) 0..15
0063- размер поля 7 (<< 25) 1..16
0064- 
0065- #define OK_ADDR             0       // размер поля 5 бит, маска 0x1F
0066- #define OK_ADDR_MASK        0x1F
0067- #define OK_SUBADDR          5       // размер поля 5 бит, маска 0x1F
0068- #define OK_SUBADDR_MASK     0x1F
0069- #define OK_WORD_NUM         10      // размер поля 6 бит, маска 0x3F
0070- #define OK_WORD_NUM_MASK    0x3F
0071- #define OK_WORD_INDEX       16      // размер поля 5 бит, маска 0x1F
0072- #define OK_WORD_INDEX_MASK  0x1F
0073- #define OK_BIT_INDEX        21      // размер поля 4 бит, маска 0x0F
0074- #define OK_BIT_INDEX_MASK   0x0F
0075- #define OK_FIELD_LEN        25      // размер поля 7 бит, маска 0x7F
0076- #define OK_FIELD_LEN_MASK   0x7F
0077- 
0078- #define OK_PLACE(Addr, SubAddr, DataSize, WordIndex, BitIndex, FieldLen) \
0079-   ((((Addr) & OK_ADDR_MASK) << OK_ADDR) | \
0080-    (((SubAddr) & OK_SUBADDR_MASK) << OK_SUBADDR) | \
0081-    (((DataSize) & OK_WORD_NUM_MASK) << OK_WORD_NUM) | \
0082-    (((WordIndex) & OK_WORD_INDEX_MASK) << OK_WORD_INDEX) | \
0083-    (((BitIndex) & OK_BIT_INDEX_MASK) << OK_BIT_INDEX) | \
0084-    (((FieldLen) & OK_FIELD_LEN_MASK) << OK_FIELD_LEN))
0085- 
0086- #define OK_END 0 
0087- 
0088- [вопросы]
0089- считывать данные OK немедленно или по метке "1s" ? = по метке
0090- скидивать в КПА все измененные OK или первый на контроле (возможно, для каждого класса отдельно) ? = все
0091- снимать ли с контроля при изменении OK ? = нет
0092- что делать если ошибка при считывании OK по метке "1s" ? = слать сообщение об ошибке для класса, перейти к следующему OK
0093- 
0094- */
